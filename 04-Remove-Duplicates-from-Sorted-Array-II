# ============================================================
# LeetCode 27 - Remove Element
# https://leetcode.com/problems/remove-element/
# Difficulty: Easy
# Pattern: In-Place Modification / Two Pointers
# ============================================================
#
# PROBLEM:
#   Given an integer array nums and an integer val, remove all
#   occurrences of val in-place. Return k — the count of
#   elements not equal to val.
#
# CONSTRAINTS:
#   0 <= nums.length <= 100
#   0 <= nums[i] <= 50
#   0 <= val <= 100
#
# ============================================================
# APPROACH 1 — Slice Assignment (Pythonic)
# ============================================================
# Idea:
#   Filter out val using list comprehension and reassign via
#   slice notation (nums[:] = ...) so the original list object
#   is mutated in-place.
#
# Time:  O(n)
# Space: O(n) — comprehension builds a temporary list
# ============================================================

class Solution:
    def removeElement(self, nums: list[int], val: int) -> int:
        nums[:] = [x for x in nums if x != val]
        return len(nums)


# ============================================================
# APPROACH 2 — Two Pointers (O(1) Space, Interview Preferred)
# ============================================================
# Idea:
#   k is the write pointer. Iterate with i; whenever nums[i]
#   != val, copy it to nums[k] and advance k.
#
# Time:  O(n)
# Space: O(1)
# ============================================================

class SolutionTwoPointers:
    def removeElement(self, nums: list[int], val: int) -> int:
        k = 0
        for i in range(len(nums)):
            if nums[i] != val:
                nums[k] = nums[i]
                k += 1
        return k


# ============================================================
# TESTS
# ============================================================

if __name__ == "__main__":
    import copy

    test_cases = [
        ([3, 2, 2, 3],          3, [2, 2]),
        ([0, 1, 2, 2, 3, 0, 4, 2], 2, [0, 1, 3, 0, 4]),
        ([],                    1, []),
        ([1],                   1, []),
        ([1],                   2, [1]),
    ]

    for approach_name, SolClass in [
        ("Slice Assignment", Solution),
        ("Two Pointers   ", SolutionTwoPointers),
    ]:
        print(f"\n── {approach_name} ──")
        sol = SolClass()
        for nums_orig, val, expected in test_cases:
            nums = copy.copy(nums_orig)
            k = sol.removeElement(nums, val)
            result = nums[:k]
            status = "✅ PASS" if sorted(result) == sorted(expected) else "❌ FAIL"
            print(f"  {status}  nums={nums_orig}, val={val} → k={k}, nums={result}  (expected {expected})")
