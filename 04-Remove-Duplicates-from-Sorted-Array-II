# ============================================================
# LeetCode 26 - Remove Duplicates from Sorted Array
# https://leetcode.com/problems/remove-duplicates-from-sorted-array/
# Difficulty: Easy
# Pattern: Two Pointers (Read / Write)
# ============================================================
#
# PROBLEM:
#   Given an integer array nums sorted in non-decreasing order,
#   remove duplicates in-place so each unique element appears
#   exactly once. Return k — the number of unique elements.
#
# CONSTRAINTS:
#   1 <= nums.length <= 3 * 10^4
#   -100 <= nums[i] <= 100
#   nums is sorted in non-decreasing order
#
# ============================================================
# APPROACH — Two Pointers (Read / Write)
# ============================================================
# Idea:
#   Since the array is sorted, duplicates are always adjacent.
#   'write' tracks the next position to fill.
#   'read' scans every element; copy to write pointer only when
#   the value differs from the last written value.
#
# Time:  O(n)
# Space: O(1)
# ============================================================

class Solution:
    def removeDuplicates(self, nums: list[int]) -> int:
        if not nums:
            return 0

        write = 1           # first element is always kept
        for read in range(1, len(nums)):
            if nums[read] != nums[write - 1]:
                nums[write] = nums[read]
                write += 1

        return write


# ============================================================
# TESTS
# ============================================================

if __name__ == "__main__":
    import copy

    test_cases = [
        ([1, 1, 2],                     [1, 2]),
        ([0, 0, 1, 1, 1, 2, 2, 3, 3, 4], [0, 1, 2, 3, 4]),
        ([1],                            [1]),
        ([1, 1, 1, 1],                   [1]),
        ([-3, -1, -1, 0, 0, 5],          [-3, -1, 0, 5]),
    ]

    sol = Solution()
    print("── Two Pointers ──")
    for nums_orig, expected in test_cases:
        nums = copy.copy(nums_orig)
        k = sol.removeDuplicates(nums)
        result = nums[:k]
        status = "✅ PASS" if result == expected else "❌ FAIL"
        print(f"  {status}  nums={nums_orig} → k={k}, nums={result}  (expected {expected})")
